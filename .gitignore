# Tudo abaixo é específico desta máquina: contém emails ou é derivado. Cada
# entrada tem um modelo versionado ao lado, quando aplicável.

# Dashboards gerados por collector/dashboard-generator.mjs, um por conta.
# Derivados do template e nomeados pelo email.
grafana/dashboards/accounts/

# Limites por conta e lista de contas ignoradas — contém emails. Recalibrado
# automaticamente pelo collector (usage-truth.mjs).
# Modelo: grafana/account-limits.example.json
grafana/account-limits.json

# Estado do collector: offsets de transcript, dedup, log do launchd. Derivado —
# perder isto só custa um re-scan completo na próxima passada.
.state/

# Git worktrees (local dev convenience, not part of the repo).
.worktrees/

# Stray binaries from a plain `go build ./...` run inside a module root
# (no -o given) — named after the cmd/ subdirectory, e.g. `go build ./...`
# from setup/ produces setup/setup.
/setup/setup
/setup/setup.exe
/dash-generator/dash-generator
/dash-generator/dash-generator.exe
/collector/collector
/collector/collector.exe
