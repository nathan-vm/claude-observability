# Tudo abaixo é específico desta máquina: contém emails ou é derivado. Cada
# entrada tem um modelo versionado ao lado, quando aplicável.

# Dashboards gerados por src/dash-generator, um por conta.
# Derivados do template e nomeados pelo email.
grafana/dashboards/accounts/

# Limites por conta e lista de contas ignoradas — contém emails. Editado à
# mão (sem mais recalibração automática — ver README.md, "The limit references").
# Modelo: grafana/account-limits.example.json
grafana/account-limits.json

# Estado do collector: offsets de transcript, dedup, log do launchd. Derivado —
# perder isto só custa um re-scan completo na próxima passada.
.state/

# Git worktrees (local dev convenience, not part of the repo).
.worktrees/

.DS_Store

# Local build output — binaries the wizard/collector are built into by hand
# (see README.md's "Getting started"); dash-generator now runs in Docker
# instead (see docker-compose.yaml), so this is just wizard + collector.
.bin/

# Stray binaries from a plain `go build ./...` run inside a module root
# (no -o given) — named after the cmd/ subdirectory, e.g. `go build ./...`
# from src/wizard/ produces src/wizard/wizard.
/src/wizard/wizard
/src/wizard/wizard.exe
/src/dash-generator/dash-generator
/src/dash-generator/dash-generator.exe
/src/collector/collector
/src/collector/collector.exe
