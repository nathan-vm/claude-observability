#!/usr/bin/env bash
# claude-observability setup — the one thing this does is get Claude Code
# telemetry flowing somewhere: today, always localhost (this repo's own
# otel-collector + loki + grafana stack). Nothing else — no skills, no MCP
# servers, no plugins; those live in the separate agents-setup project this
# one was split out of, once observability outgrew it.
#
# Usage:
#   bin/setup           # interactive: which accounts, then bring the stack up
#   bin/setup --help

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

section() { echo; echo "── $1 ──────────────────────────────────────"; }

ask_yn() {
  local prompt="$1" default="${2:-N}" hint ans
  hint="y/N"; [ "$default" = "Y" ] && hint="Y/n"
  read -r -p "$prompt [$hint] " ans || ans=""
  ans="${ans:-$default}"
  [[ "$ans" =~ ^[Yy] ]]
}

# Discovers Claude Code config directories (the ones with "projects/" inside)
# and the account of each, read from oauthAccount in .claude.json. Echoes
# "path<TAB>email". ~/.claude is Claude Code's own default; ~/.claude-* covers
# accounts split by context (~/.claude-personal, ~/.claude-work, ...).
discover_claude_dirs() {
  local d email
  for d in "$HOME"/.claude "$HOME"/.claude-*; do
    [ -d "$d/projects" ] || continue
    email="$(python3 -c 'import json,sys,pathlib
try:
    c = json.load(open(pathlib.Path(sys.argv[1]) / ".claude.json")).get("oauthAccount") or {}
    print(c.get("emailAddress") or "")
except Exception:
    print("")' "$d" 2>/dev/null)"
    printf '%s\t%s\n' "$d" "${email:-(unidentified account)}"
  done
}

# Discovers/prompts for which accounts to monitor and sets (global, for the
# caller): OBS_PRIMARY_DIR, OBS_EXTRA_DIRS (colon-separated, may be empty),
# OBS_EXPORTER_STREAM. Writes nothing itself — collector config lives as
# plain env vars in the shell rc, not a file, so main() (the caller) writes
# them alongside the OTel telemetry vars. Also records in account-limits.json
# the accounts the user does NOT want to monitor.
#
# rc_for_continuity: the shell rc file to check for an EXPORTER_STREAM this
# script already wrote on a previous run — changing that value by accident
# makes the stack reimport everything into a new stream and orphan the old
# one, so it is preserved rather than reset every run.
choose_accounts() {
  local rc_for_continuity="$1"
  section "Which accounts to monitor"

  OBS_PRIMARY_DIR=""
  OBS_EXTRA_DIRS=""
  OBS_EXPORTER_STREAM=""

  local -a dirs=() emails=()
  local d e
  while IFS="$(printf '\t')" read -r d e; do
    dirs+=("$d"); emails+=("$e")
  done < <(discover_claude_dirs)

  if [ "${#dirs[@]}" -eq 0 ]; then
    echo "  No config directory found (~/.claude*/projects)."
    echo "  Falling back to ~/.claude — re-run this after your first Claude Code session."
    OBS_PRIMARY_DIR='${HOME}/.claude'
    OBS_EXPORTER_STREAM="claude-code-exporter-1"
    return
  fi

  echo "  Found:"
  local i
  for i in "${!dirs[@]}"; do
    printf '    [%d] %-24s %s\n' "$((i+1))" "$(basename "${dirs[$i]}")" "${emails[$i]}"
  done
  echo

  local -a chosen=()
  if [ "${#dirs[@]}" -eq 1 ]; then
    chosen=(0)
    echo "  Only one directory — using it."
  elif ask_yn "  Monitor all of these accounts?" Y; then
    for i in "${!dirs[@]}"; do chosen+=("$i"); done
  else
    for i in "${!dirs[@]}"; do
      ask_yn "    Monitor ${emails[$i]} ($(basename "${dirs[$i]}"))?" Y && chosen+=("$i")
    done
  fi

  if [ "${#chosen[@]}" -eq 0 ]; then
    echo "  No account selected; nothing to configure."
    return
  fi

  local stream=""
  if [ -n "$rc_for_continuity" ] && [ -f "$rc_for_continuity" ]; then
    # bash/zsh write "export EXPORTER_STREAM=value"; fish writes
    # "set -gx EXPORTER_STREAM value" — try both, harmless if neither matches.
    stream="$(sed -n 's/^[[:space:]]*export EXPORTER_STREAM=["'"'"']\{0,1\}\([^"'"'"']*\).*/\1/p' "$rc_for_continuity" | tail -1)"
    [ -n "$stream" ] || stream="$(sed -n 's/^[[:space:]]*set -gx EXPORTER_STREAM \([^ ]*\).*/\1/p' "$rc_for_continuity" | tail -1)"
  fi
  [ -n "$stream" ] || stream="claude-code-exporter-1"

  OBS_PRIMARY_DIR="${dirs[${chosen[0]}]}"
  OBS_EXPORTER_STREAM="$stream"
  local idx
  for idx in "${chosen[@]:1}"; do
    OBS_EXTRA_DIRS="${OBS_EXTRA_DIRS:+$OBS_EXTRA_DIRS:}${dirs[$idx]}"
  done
  echo "  ${#chosen[@]} directory(ies) configured"

  # A discovered account that was left out goes on the ignore list: without it
  # dashboard-generator.mjs creates an empty dashboard for it as soon as the
  # email shows up in Loki.
  local -a out_of=()
  local inside
  for i in "${!dirs[@]}"; do
    inside=0
    for idx in "${chosen[@]}"; do [ "$idx" = "$i" ] && inside=1; done
    if [ "$inside" = 0 ] && [ "${emails[$i]}" != "(unidentified account)" ]; then
      out_of+=("${emails[$i]}")
    fi
  done
  local limits_file="$REPO_ROOT/grafana/account-limits.json"
  [ -f "$limits_file" ] || cp "$REPO_ROOT/grafana/account-limits.example.json" "$limits_file"
  if [ "${#out_of[@]}" -gt 0 ]; then
    if command -v jq >/dev/null; then
      local tmp; tmp="$(mktemp)"
      jq --argjson ig "$(printf '%s\n' "${out_of[@]}" | jq -R . | jq -s .)" \
        '.ignore = $ig | .accounts = {}' "$limits_file" > "$tmp" && mv "$tmp" "$limits_file"
      echo "  not monitored: ${out_of[*]}"
    else
      echo "  warning: jq missing — add this by hand to grafana/account-limits.json:"
      echo "           \"ignore\": [${out_of[*]}]"
    fi
  fi
}

main() {
  echo "claude-observability setup"
  echo "Sends Claude Code telemetry somewhere — today, always localhost (this repo's"
  echo "own otel-collector + loki + grafana stack)."

  local marker="# claude-observability: telemetry + collector config"
  local shell_name; shell_name="$(basename "${SHELL:-bash}")"
  local rc="$HOME/.bashrc"
  [ "$shell_name" = "zsh" ] && rc="$HOME/.zshrc"
  local fish_cfg="$HOME/.config/fish/config.fish"
  local target_rc="$rc"
  [ "$shell_name" = "fish" ] && target_rc="$fish_cfg"

  # Discovers accounts and updates account-limits.json's ignore list every
  # run (cheap, idempotent); only sets OBS_PRIMARY_DIR/OBS_EXTRA_DIRS/
  # OBS_EXPORTER_STREAM for the rc block below to use.
  choose_accounts "$target_rc"

  section "Bringing the stack up"
  ( cd "$REPO_ROOT" && docker compose up -d )
  echo "  Grafana: http://localhost:47300"

  section "Enabling telemetry in this shell"
  if [ "$shell_name" = "fish" ]; then
    if ! grep -qF "$marker" "$fish_cfg" 2>/dev/null; then
      {
        echo "$marker"
        cat "$REPO_ROOT/bin/claude-telemetry.fish"
        if [ -n "$OBS_PRIMARY_DIR" ]; then
          echo "set -gx CLAUDE_DIR \"$OBS_PRIMARY_DIR\""
          [ -n "$OBS_EXTRA_DIRS" ] && echo "set -gx CLAUDE_OBSERVABILITY_EXTRA_DIRS \"$OBS_EXTRA_DIRS\""
          echo "set -gx EXPORTER_STREAM \"$OBS_EXPORTER_STREAM\""
        fi
      } >> "$fish_cfg"
      echo "  telemetry + collector env vars added to $fish_cfg"
    else
      echo "  already present in $fish_cfg (edit the block by hand to change accounts)"
    fi
  else
    if ! grep -qF "$marker" "$rc" 2>/dev/null; then
      {
        echo "$marker"
        cat "$REPO_ROOT/bin/claude-telemetry.sh"
        if [ -n "$OBS_PRIMARY_DIR" ]; then
          echo "export CLAUDE_DIR=\"$OBS_PRIMARY_DIR\""
          [ -n "$OBS_EXTRA_DIRS" ] && echo "export CLAUDE_OBSERVABILITY_EXTRA_DIRS=\"$OBS_EXTRA_DIRS\""
          echo "export EXPORTER_STREAM=\"$OBS_EXPORTER_STREAM\""
        fi
      } >> "$rc"
      echo "  telemetry + collector env vars added to $rc (open a new terminal, or 'source $rc')"
    else
      echo "  already present in $rc (edit the block by hand to change accounts)"
    fi
  fi

  section "Next step"
  echo "  bin/install-service.sh install     # runs the collector (transcript scan,"
  echo "                                      # usage meters, dashboards) as a service"
}

main "$@"
